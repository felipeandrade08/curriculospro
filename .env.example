# Neon PostgreSQL
DATABASE_URL=

# Neon Auth
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# E-mail autorizado para acessar /admin
ADMIN_EMAIL=

# Integração opcional de adaptação de currículo com OpenAI
OPENAI_API_KEY=
ENABLE_PAID_AI=false
# OPENAI_TAILOR_MODEL=

# Mercado Pago (pagamento Pix do acesso de 7 dias)
# Access Token de PRODUÇÃO: Mercado Pago Developers > Suas integrações > Credenciais de produção
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta das notificações: Suas integrações > Webhooks > "Assinatura secreta"
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública do site, usada no endereço de notificação do Mercado Pago (opcional na Vercel)
SITE_URL=https://curriculospro.vercel.app
